def ask(prompt, default):
    if not sys.stdin.isatty():
        return default
    try:
        got = input("%s [%s]: " % (prompt, default)).strip()
    except EOFError:        # Windows calls the NUL device a terminal, so isatty() lets a closed input through
        print()
        return default
    return got or default


def cmd_mcp(args):
    """Serve MCP on stdin/stdout for an AI tool. It reads the running dashboard, so no vault flag needed."""
    sys.path.insert(0, APP)
    import mcp_server
    _, port = resolve(args)
    mcp_server.serve(port)
    return 0


def cmd_mail(args):
    """Set up, test or remove the mail account used for reminders. It's kept outside the vault."""
    sys.path.insert(0, APP)
    import reminders
    import getpass
    path = reminders.mail_path()
    if args.action == "off":
        old = reminders.load_mail()
        if old and old.get("password_store", "file") != "file":
            reminders.forget_password(old["password_store"], old["user"])
        if os.path.exists(path):
            os.remove(path)
        print("Mail is off; the settings file is gone (%s)%s." % (path, ", and so is the stored password" if old and old.get("password_store", "file") != "file" else ""))
        return 0
    if args.action == "test":
        m = reminders.load_mail()
        if not m:
            print("Mail isn't set up. Run: ./edu4self mail setup")
            return 1
    else:
        print("Away mails and the Sunday recap come by mail, from your own account.")
        print("Use an app password, not your main one (Gmail: myaccount.google.com/apppasswords).")
        print("It never goes in your vault. You choose where it's kept; a test mail goes out before anything is saved.\n")
        old = reminders.load_mail() or {}
        ask = lambda q, d: (input("%s [%s]: " % (q, d)) if d else input("%s: " % q)).strip() or d
        user = ask("Your mail address (the account that sends)", old.get("user", ""))
        known = {"gmail.com": ("smtp.gmail.com", 465), "googlemail.com": ("smtp.gmail.com", 465),
                 "icloud.com": ("smtp.mail.me.com", 587), "me.com": ("smtp.mail.me.com", 587),
                 "outlook.com": ("smtp-mail.outlook.com", 587), "hotmail.com": ("smtp-mail.outlook.com", 587),
                 "fastmail.com": ("smtp.fastmail.com", 465)}
        guess = known.get(user.rsplit("@", 1)[-1].lower(), (old.get("host", ""), old.get("port", 465)))
        host = ask("SMTP server", guess[0])
        port = int(ask("Port (465 = SSL, 587 = STARTTLS)", str(old.get("port", guess[1]))))
        pw = getpass.getpass("App password%s: " % (" (Enter keeps the old one)" if old.get("password") else "")) or old.get("password") or ""
        to = ask("Send reminders to", old.get("to") or user)
        m = {"host": host, "port": port, "security": "ssl" if port == 465 else "starttls", "user": user, "password": pw, "to": to}
        stores = reminders.password_stores()
        m["password_store"] = "file"
        if len(stores) > 1:
            print("\nWhere should the app password be kept? Each has a risk:")
            for i, st in enumerate(stores, 1):
                what, risk = reminders.PASSWORD_STORES[st]
                print("  %d. %s%s\n     %s" % (i, what % path if "%s" in what else what, " (default)" if i == 1 else "", risk))
            was = old.get("password_store", "file")
            pick = ask("Choose", str(stores.index(was) + 1 if was in stores else 1))
            m["password_store"] = stores[int(pick) - 1] if pick.isdigit() and 1 <= int(pick) <= len(stores) else "file"
        elif platform.system() == "Windows":
            print("\nOn Windows the app password is kept in a file in your user folder (%s)." % reminders.mail_path())
            print("Windows has no password store this tool can use without extra software, and file permissions")
            print("here don't hide it from other programs running as you. Use an app password, not your real one.")
    try:
        reminders.send_mail(m, "edu4self: mail works", "This is the test mail from edu4self. Away mails and your Sunday recap will come like this.")
    except Exception as exc:
        print("Couldn't send the test mail: %s" % exc)
        print("Nothing was saved. Check the server, port and app password, and try again." if args.action == "setup" else "")
        return 1
    if args.action == "setup":
        try:
            reminders.save_mail(m)
        except OSError as exc:
            print("The test mail went out, but the password couldn't be stored: %s" % exc)
            print("Nothing was saved. Run setup again and pick another place.")
            return 1
        was = old.get("password_store", "file") if old else "file"
        if was != "file" and (was != m["password_store"] or old["user"] != m["user"]):
            reminders.forget_password(old["password_store"], old["user"])     # moved: don't leave a copy behind
        what = reminders.PASSWORD_STORES[m["password_store"]][0]
        print("Sent a test mail to %s and saved the settings; the password is in %s." % (m["to"], what % path if "%s" in what else what))
    else:
        print("Sent a test mail to %s." % m["to"])
    return 0


def cmd_setup(args):
    print("edu4self setup. Press Enter to accept the suggestion in brackets.\n")
    want_port = args.port or int(read_settings().get("port") or DEFAULT_PORT)
    if port_busy(want_port) and not health(want_port):      # ours answering is fine (a re-run); anything else is in the way
        sys.exit(port_taken_message(want_port).replace("./edu4self serve --port", "./edu4self setup --port"))
    path = args.vault or ask("Where should your learning vault go?", "~/learn")
    existing = os.path.abspath(os.path.expanduser(path))
    reuse = os.path.isfile(os.path.join(existing, "_system", "state.json"))
    if reuse:
        print("\n%s already holds a vault." % existing)
        if not ask("Use it and carry on with the rest of setup? (y/n)", "y").lower().startswith("y"):
            sys.exit("Pick another folder:  ./edu4self setup --vault <new folder>")
    name = args.name if args.name is not None or reuse else ask("What should the dashboard call you?", os.environ.get("USER", "").capitalize() or "friend")
    gifts = args.gifts
    if gifts is None and sys.stdin.isatty() and not reuse:
        print("\nWhen you win a week or finish a die, Claude can make you a small gift from what you proved.")
        print("Each gift is one short Claude run on your own account, so it uses a little of your plan.")
        gifts = "on" if ask("Turn gifts on? (y/n)", "n").lower().startswith("y") else "off"
    claude = find_claude()
    plugin = not args.no_plugin and bool(claude)
    if plugin and sys.stdin.isatty():
        print("\nClaude needs the edu4self plugin: it holds the tutor's skills (writing lessons, grading your work).")
        plugin = ask("Install the tutor plugin now? (y/n)", "y").lower().startswith("y")
    if reuse:
        vault, port = existing, want_port
        write_settings(vault=vault, port=port)
        print("Using the vault at %s (its files are left as they are)." % vault)
    else:
        ns = argparse.Namespace(path=path, name=name, port=args.port, no_example=args.no_example, gifts=gifts)
        vault, port = cmd_init(ns)
    rc = 0
    if not args.no_service:
        rc = cmd_install(argparse.Namespace(vault=vault, port=port))
    installed = False
    if plugin:
        print("\nInstalling the tutor plugin for Claude Code:")
        installed = install_plugin(claude)
    elif not claude:
        print("\nClaude Code is needed: it's the tutor that writes your lessons and grades your work.")
        print("Install it from https://claude.com/claude-code, then do step 1 below.")
    print("\nNext:")
    n = 1
    if not installed:
        print("  1. Give Claude the tutor skills (once):")
        print_plugin_steps()
        n = 2
    print("  %d. Open the dashboard:   http://127.0.0.1:%d/" % (n, port))
    print("  %d. Work from your vault: cd %s && claude" % (n + 1, shell_quote(vault)))
    if args.no_service or rc:
        print("\nThe dashboard isn't running as a service. Start it with:  ./edu4self serve")
    elif not args.no_open:
        webbrowser.open("http://127.0.0.1:%d/" % port)
    return 0


def main(argv=None):
    ap = argparse.ArgumentParser(prog="edu4self", description="A local learning dashboard with an AI tutor loop.")
    sub = ap.add_subparsers(dest="cmd")

    def common(p, vault=True):
        if vault:
            p.add_argument("--vault", help="the vault folder (default: the one init made)")
        p.add_argument("--port", type=int, help="dashboard port (default %d)" % DEFAULT_PORT)
        return p

    p = common(sub.add_parser("setup", help="first-time setup: vault + service + open"), vault=False)
    p.add_argument("--vault", help="where to make the vault (default ~/learn)")
    p.add_argument("--name", help="what the dashboard calls you")
    p.add_argument("--no-example", action="store_true", help="start without the example topic")
    p.add_argument("--no-service", action="store_true", help="don't start at login")
    p.add_argument("--no-open", action="store_true", help="don't open a browser")
    p.add_argument("--no-plugin", action="store_true", help="don't install the tutor plugin for Claude Code")
    p.add_argument("--gifts", choices=("on", "off"), help="Claude gifts for a won week or die (uses your Claude plan); "
                   "left out: asked here, or by the dashboard")
    p = common(sub.add_parser("init", help="make a new vault"), vault=False)
    p.add_argument("path")
    p.add_argument("--name", default="")
    p.add_argument("--no-example", action="store_true")
    p.add_argument("--gifts", choices=("on", "off"))
    p = common(sub.add_parser("serve", help="run the dashboard in this terminal"))
    p.add_argument("--open", action="store_true", help="open a browser too")
    for name, h in (("install", "start at login"), ("uninstall", "stop starting at login"), ("restart", "restart the service"),
                    ("status", "what's running"), ("check", "validate the vault"), ("doctor", "check everything"),
                    ("open", "open the dashboard")):
        p = common(sub.add_parser(name, help=h))
        if name == "check":
            p.add_argument("--overrule", action="store_true",
                           help="turn a pass the answer key's checklist doesn't allow into not passed, then check")
    common(sub.add_parser("mcp", help="progress for AI tools over MCP (stdio)"), vault=False)
    p = sub.add_parser("mail", help="reminders by mail: setup, test or off")
    p.add_argument("action", choices=("setup", "test", "off"))
    args = ap.parse_args(argv)
    if not args.cmd:
        ap.print_help()
        return 0
    if args.cmd == "init":
        cmd_init(args)
        print("Start it with:  ./edu4self serve --open   (or ./edu4self install to start at login)")
        return 0
    return {"setup": cmd_setup, "serve": cmd_serve, "install": cmd_install, "uninstall": cmd_uninstall,
            "restart": cmd_restart, "status": cmd_status, "check": cmd_check, "doctor": cmd_doctor,
            "open": cmd_open, "mail": cmd_mail, "mcp": cmd_mcp}[args.cmd](args)


if __name__ == "__main__":
    sys.exit(main() or 0)
