#!/usr/bin/env python3
"""edu4self command line. Python 3.9+ standard library only.

    ./edu4self setup                 first time: make a vault, give Claude the tutor plugin, start the dashboard, open it
    ./edu4self init PATH             make a new vault (learning folder) at PATH
    ./edu4self serve                 run the dashboard in this terminal (Ctrl-C stops it)
    ./edu4self install               start the dashboard at login (macOS launchd, Linux systemd, Windows Task Scheduler)
    ./edu4self uninstall             stop doing that (your files stay)
    ./edu4self restart | status      restart the service / show what's running
    ./edu4self check                 validate state.json and every link in the vault (Claude runs this)
    ./edu4self doctor                check everything and say how to fix what's wrong
    ./edu4self open                  open the dashboard in a browser
    ./edu4self mail setup|test|off   away mails and the Sunday recap (your own mail account)
    ./edu4self mcp                   your progress for any AI tool that speaks MCP (see docs/MCP.md)

The vault and port are remembered in ~/.config/edu4self/settings.json after init.
"""
import argparse
import errno
import json
import os
import platform
import shutil
import subprocess
import sys
import time
import urllib.request
import webbrowser
from datetime import datetime

ENGINE = os.path.dirname(os.path.realpath(__file__))
APP = os.path.join(ENGINE, "app")
TEMPLATE = os.path.join(ENGINE, "template")
EXAMPLE_TOPIC = "how-learning-works"
LABEL = "io.github.edu4self.dashboard"
DEFAULT_PORT = 4747

sys.path.insert(0, APP)

if os.name == "nt":      # a pipe or file on Windows defaults to the legacy code page, which can't print ✓ or ·
    for _s in (sys.stdin, sys.stdout, sys.stderr):
        if _s is not None and hasattr(_s, "reconfigure"):
            _s.reconfigure(encoding="utf-8", errors="replace")


def settings_path():
    base = os.environ.get("EDU4SELF_CONFIG_HOME") or os.path.join(
        os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "edu4self")
    return os.path.join(base, "settings.json")


def read_settings():
    try:
        with open(settings_path(), encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return {}


def write_settings(**kw):
    s = read_settings()
    s.update(kw)
    os.makedirs(os.path.dirname(settings_path()), exist_ok=True)
    with open(settings_path(), "w", encoding="utf-8") as fh:
        json.dump(s, fh, indent=2)
        fh.write("\n")


def resolve(args):
    """The vault and port to use: flags, then environment, then what init remembered."""
    s = read_settings()
    vault = getattr(args, "vault", None) or os.environ.get("EDU4SELF_VAULT") or s.get("vault")
    port = getattr(args, "port", None) or int(os.environ.get("EDU4SELF_PORT") or s.get("port") or DEFAULT_PORT)
    if vault:
        vault = os.path.abspath(os.path.expanduser(vault))
    return vault, int(port)


def need_vault(vault):
    if not vault or not os.path.isfile(os.path.join(vault, "_system", "state.json")):
        sys.exit("No vault found%s. Make one with:  ./edu4self init ~/learn" % (" at " + vault if vault else ""))
    return vault


def say(mark, text):
    print("  %s %s" % (mark, text))


# ---------------------------------------------------------------- init

def cmd_init(args):
    vault = os.path.abspath(os.path.expanduser(args.path))
    if os.path.exists(vault) and os.listdir(vault):
        sys.exit("%s already exists and isn't empty. Pick a new folder (it gets created)." % vault)
    port = args.port or DEFAULT_PORT
    name = (args.name or "").strip()
    today = datetime.now().astimezone()

    def skip(src, names):
        out = [n for n in names if n.endswith(".tmpl") or n in (".DS_Store", "__pycache__")]
        if args.no_example and os.path.abspath(src) in (os.path.abspath(TEMPLATE),
                                                         os.path.abspath(os.path.join(TEMPLATE, "_system", "keys"))):
            out.append(EXAMPLE_TOPIC)              # the topic folder, and its answer keys
        return out
    shutil.copytree(TEMPLATE, vault, ignore=skip, dirs_exist_ok=True)

    # state.json: today's dates, the learner's name, and no example topic if asked
    sp = os.path.join(vault, "_system", "state.json")
    with open(sp, encoding="utf-8") as fh:
        state = json.load(fh)
    state["updated"] = today.isoformat(timespec="seconds")
    state["learner"] = name
    state["coach"]["date"] = today.date().isoformat()
    if args.no_example:
        state["topics"] = []
        state["coach"].update(headline="Welcome. Start your first topic.",
                              body="Open Claude Code in this folder and say what you want to learn.")
        state["coach"]["voices"] = [{"voice": "regular", "text": "Empty bar. Best seat in the house. What are we learning?"}]
    for t in state["topics"]:
        for h in t["history"]:
            h["date"] = today.date().isoformat()
    with open(sp, "w", encoding="utf-8") as fh:
        json.dump(state, fh, indent=1, ensure_ascii=False)
        fh.write("\n")

    plan = os.path.join(vault, "PLAN.md")
    if os.path.isfile(plan):
        with open(plan, encoding="utf-8") as fh:
            text = fh.read().replace("{{DATE}}", today.date().isoformat())
        if args.no_example:   # no topics yet: an order with nothing in it, not the example's units
            head, _, _ = text.partition("| 1 |")
            text = head + "| 1 | your first topic | Lesson 01, once your first topic is set up | next |\n\n## Changes\n\n" + \
                "- %s: an empty vault; the plan fills in with the first topic.\n" % today.date().isoformat()
        with open(plan, "w", encoding="utf-8") as fh:
            fh.write(text)

    home = os.path.join(vault, "Home.md")
    if os.path.isfile(home):
        with open(home, encoding="utf-8") as fh:
            text = fh.read().replace("{{PORT}}", str(port))
        with open(home, "w", encoding="utf-8") as fh:
            fh.write(text)

    cfg = {"name": name}
    gifts = getattr(args, "gifts", None)
    if gifts in ("on", "off"):
        cfg["gifts"] = gifts == "on"        # left out: the dashboard asks the first time it opens
    with open(os.path.join(vault, "_system", "config.json"), "w", encoding="utf-8") as fh:
        json.dump(cfg, fh, indent=2)
        fh.write("\n")

    # instructions for the tutor: CLAUDE.md for Claude Code, AGENTS.md for other agents
    with open(os.path.join(TEMPLATE, "CLAUDE.md.tmpl"), encoding="utf-8") as fh:
        text = fh.read()
    check = "python3 %s check --vault %s" % (shell_quote(os.path.join(ENGINE, "edu4self")), shell_quote(vault))
    text = (text.replace("{{NAME}}", name or "the learner").replace("{{PORT}}", str(port))
            .replace("{{ENGINE}}", ENGINE).replace("{{CHECK}}", check))
    for fname in ("CLAUDE.md", "AGENTS.md"):
        with open(os.path.join(vault, fname), "w", encoding="utf-8") as fh:
            fh.write(text)
    write_settings(vault=vault, port=port)
    print("Made a vault at %s" % vault)
    return vault, port


def shell_quote(s):
    return "'" + s.replace("'", "'\\''") + "'" if any(c in s for c in " '\"$`\\") else s


# ---------------------------------------------------------------- check

def cmd_check(args):
    vault = need_vault(resolve(args)[0])
    a = subprocess.run([sys.executable, os.path.join(APP, "validate_state.py"), vault]
                       + (["--overrule"] if getattr(args, "overrule", False) else []))
    b = subprocess.run([sys.executable, os.path.join(APP, "check_links.py"), vault])
    c = check_config(vault)
    t = check_themes(vault)
    return 0 if a.returncode == 0 and b.returncode == 0 and c and t else 1


def check_themes(vault, quiet=False):
    """Rooms in <vault>/themes/ with the server's own checks, and that the chosen room opens.
    A broken room never breaks the page (it falls back to the bar), so this is where you find out why."""
    import server
    import themes
    server.configure(vault, DEFAULT_PORT)
    ok = True
    mine = os.path.join(vault, "themes")
    for tid, path in themes.folders(server.THEMES_DIR, vault).items():
        if not path.startswith(os.path.join(mine, "")):
            continue
        errs = themes.load(path, tid)["errors"]
        if errs:
            ok = False
            print("themes/%s: FAILED" % tid)
            for e in errs:
                print("  - %s" % e)
        elif not quiet:
            print("themes/%s: OK" % tid)
    try:
        chosen = server.clean_config(json.loads(server.read_text(server.CONFIG) or "{}")).get("theme", "bar")
    except ValueError:
        chosen = "bar"
    path = themes.folders(server.THEMES_DIR, vault).get(chosen)
    if not path:
        ok = False
        print("config.json: FAILED: the room '%s' doesn't exist, so the bar is showing instead" % chosen)
    elif themes.load(path, chosen)["errors"]:
        ok = False
        print("config.json: FAILED: the room '%s' has problems (above), so the bar is showing instead" % chosen)
    return ok


def check_config(vault):
    """config.json with the same rules the server uses. A bad file doesn't break the dashboard (it falls
    back to defaults), so without this an agent's mistake would go unnoticed."""
    import server
    server.configure(vault, DEFAULT_PORT)
    raw = server.read_text(server.CONFIG)
    if not raw.strip():
        print("config.json: none, defaults in use")
        return True
    try:
        cfg = server.clean_config(json.loads(raw))
    except ValueError as exc:
        print("config.json: FAILED: %s" % exc)
        return False
    for track in cfg["music"]["files"]:
        if not os.path.isfile(os.path.join(server.MUSIC_DIR, track["file"])):
            print("config.json: FAILED: music file %s isn't in _system/music/" % track["file"])
            return False
    print("config.json: OK")
    return True


# ---------------------------------------------------------------- serve

def cmd_serve(args):
    vault, port = resolve(args)
    need_vault(vault)
    import server
    try:
        httpd = server.make_server(vault, port)
    except OSError as exc:
        sys.exit(port_taken_message(port, exc))
    url = "http://127.0.0.1:%d/" % port
    print("edu4self %s on %s (vault %s). Ctrl-C stops it." % (server.VERSION, url, vault))
    if args.open:
        webbrowser.open(url)
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


def port_taken_message(port, exc=None):
    why = " (%s)" % exc.strerror if exc is not None and getattr(exc, "strerror", None) and not is_in_use(exc) else ""
    return ("Port %d is already in use%s: another edu4self or another program has it.\n"
            "Pick a free one with --port, for example:  ./edu4self serve --port %d\n"
            "(./edu4self status shows whether it is edu4self.)" % (port, why, port + 1))


def is_in_use(exc):
    return getattr(exc, "errno", None) in (errno.EADDRINUSE, 10048, 10013)


def port_busy(port):
    """True when something already listens on this port on this machine."""
    import socket
    with socket.socket() as s:
        s.settimeout(1)
        return s.connect_ex(("127.0.0.1", port)) == 0


def health(port, timeout=1.5):
    try:
        with urllib.request.urlopen("http://127.0.0.1:%d/api/health" % port, timeout=timeout) as r:
            return json.load(r)
    except Exception:
        return None


# ---------------------------------------------------------------- service

def python_path():
    """An interpreter path that survives minor upgrades (the PATH symlink, not the versioned binary)."""
    p = shutil.which("python3")
    return os.path.abspath(p) if p else sys.executable


def service_path():
    """The PATH the service runs with. launchd and systemd start services with a bare PATH, so a server
    started at login can't find `claude` (usually in ~/.local/bin or Homebrew) and the Claude panel stays
    off. Bake in the PATH of the shell that ran install, with claude's own folder first."""
    dirs = []
    exe = shutil.which("claude")
    if exe:
        dirs.append(os.path.dirname(os.path.abspath(exe)))
    for d in os.environ.get("PATH", "").split(os.pathsep) + ["/usr/local/bin", "/usr/bin", "/bin"]:
        if d and os.path.isabs(d) and d not in dirs:
            dirs.append(d)
    return os.pathsep.join(dirs)


def launchd_plist(vault, port):
    logs = os.path.join(vault, "_system", "logs")
    args = "".join("    <string>%s</string>\n" % xml(a) for a in
                   (python_path(), os.path.join(APP, "server.py"), "--vault", vault, "--port", str(port)))
    return ("""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>%s</string>
  <key>ProgramArguments</key>
  <array>
%s  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>%s</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>WorkingDirectory</key>
  <string>%s</string>
  <key>StandardOutPath</key>
  <string>%s</string>
  <key>StandardErrorPath</key>
  <string>%s</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
""" % (LABEL, args, xml(service_path()), xml(vault), xml(os.path.join(logs, "dashboard.log")), xml(os.path.join(logs, "dashboard.log"))))


def xml(s):
    return s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def systemd_unit(vault, port):
    q = lambda s: '"%s"' % s.replace("\\", "\\\\").replace('"', '\\"')
    return """[Unit]
Description=edu4self learning dashboard
After=network.target

[Service]
Environment=%s
ExecStart=%s %s --vault %s --port %d
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
""" % (q("PATH=" + service_path()), q(python_path()), q(os.path.join(APP, "server.py")), q(vault), port)


def plist_path():
    return os.path.expanduser("~/Library/LaunchAgents/%s.plist" % LABEL)


def unit_path():
    return os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "systemd", "user", "edu4self.service")


TASK_NAME = "edu4self"


def windows_python():
    """pythonw.exe (no console window) next to the running Python, else python.exe."""
    d = os.path.dirname(os.path.abspath(sys.executable))
    for name in ("pythonw.exe", "python.exe"):
        if os.path.isfile(os.path.join(d, name)):
            return os.path.join(d, name)
    return sys.executable


def windows_task_xml(vault, port, user=None):
    """The Task Scheduler definition: run the server when this user logs on. It is XML (not plain
    `schtasks /SC ONLOGON /TR ...`) because that route leaves Windows' default 72-hour limit on the task,
    which would kill the dashboard after three days, and has no restart on failure."""
    user = user or os.environ.get("USERDOMAIN", "") + "\\" + os.environ.get("USERNAME", "")
    arguments = subprocess.list2cmdline([os.path.join(APP, "server.py"), "--vault", vault, "--port", str(port)])
    return """<?xml version="1.0" encoding="UTF-16"?>
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo><Description>edu4self learning dashboard</Description></RegistrationInfo>
  <Triggers>
    <LogonTrigger><Enabled>true</Enabled><UserId>%s</UserId></LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author"><UserId>%s</UserId><LogonType>InteractiveToken</LogonType><RunLevel>LeastPrivilege</RunLevel></Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <RestartOnFailure><Interval>PT1M</Interval><Count>99</Count></RestartOnFailure>
    <StartWhenAvailable>true</StartWhenAvailable>
  </Settings>
  <Actions Context="Author">
    <Exec><Command>%s</Command><Arguments>%s</Arguments><WorkingDirectory>%s</WorkingDirectory></Exec>
  </Actions>
</Task>
""" % (xml(user), xml(user), xml(windows_python()), xml(arguments), xml(vault))


def schtasks(*a):
    """The schtasks command line for one action (kept separate so tests can check it without Windows)."""
    return ["schtasks"] + list(a)


def run(cmd, check=False):
    return subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, check=check)


def cmd_install(args):
    vault, port = resolve(args)
    need_vault(vault)
    write_settings(vault=vault, port=port)   # status, doctor and open use the same port from now on
    os.makedirs(os.path.join(vault, "_system", "logs"), exist_ok=True)
    system = platform.system()
    if system == "Darwin":
        dest = plist_path()
        os.makedirs(os.path.dirname(dest), exist_ok=True)
        with open(dest, "w", encoding="utf-8") as fh:
            fh.write(launchd_plist(vault, port))
        dom = "gui/%d" % os.getuid()
        run(["launchctl", "bootout", "%s/%s" % (dom, LABEL)])
        r = run(["launchctl", "bootstrap", dom, dest])
        if r.returncode:
            sys.exit("launchctl couldn't start it:\n" + r.stdout)
    elif system == "Linux" and shutil.which("systemctl"):
        dest = unit_path()
        os.makedirs(os.path.dirname(dest), exist_ok=True)
        with open(dest, "w", encoding="utf-8") as fh:
            fh.write(systemd_unit(vault, port))
        run(["systemctl", "--user", "daemon-reload"])
        r = run(["systemctl", "--user", "enable", "--now", "edu4self.service"])
        if r.returncode:
            sys.exit("systemctl couldn't start it:\n" + r.stdout)
    elif system == "Windows":
        xml_path = os.path.join(vault, "_system", "logs", "edu4self-task.xml")
        with open(xml_path, "w", encoding="utf-16") as fh:      # schtasks wants UTF-16 with a BOM
            fh.write(windows_task_xml(vault, port))
        r = run(schtasks("/Create", "/F", "/TN", TASK_NAME, "/XML", xml_path))
        if r.returncode:
            sys.exit("Task Scheduler refused the task:\n" + r.stdout)
        run(schtasks("/End", "/TN", TASK_NAME))
        run(schtasks("/Run", "/TN", TASK_NAME))
    else:
        print("Starting at login isn't automated on %s yet. Run  ./edu4self serve  in a terminal instead." % system)
        return 1
    for _ in range(20):
        if health(port):
            print("The dashboard is running at http://127.0.0.1:%d/ and starts at login." % port)
            return 0
        time.sleep(0.25)
    print("Installed, but nothing answers on port %d yet. Run ./edu4self doctor." % port)
    return 1


def cmd_uninstall(args):
    system = platform.system()
    if system == "Darwin":
        run(["launchctl", "bootout", "gui/%d/%s" % (os.getuid(), LABEL)])
        if os.path.exists(plist_path()):
            os.remove(plist_path())
    elif system == "Linux" and shutil.which("systemctl"):
        run(["systemctl", "--user", "disable", "--now", "edu4self.service"])
        if os.path.exists(unit_path()):
            os.remove(unit_path())
            run(["systemctl", "--user", "daemon-reload"])
    elif system == "Windows":
        run(schtasks("/End", "/TN", TASK_NAME))
        run(schtasks("/Delete", "/F", "/TN", TASK_NAME))
    print("The login service is removed. Your vault is untouched.")
    return 0


def service_installed():
    if platform.system() == "Windows":
        return run(schtasks("/Query", "/TN", TASK_NAME)).returncode == 0
    return os.path.exists(plist_path()) if platform.system() == "Darwin" else os.path.exists(unit_path())


def cmd_restart(args):
    if not service_installed():
        print("No login service is installed. Use ./edu4self serve, or ./edu4self install.")
        return 1
    if platform.system() == "Windows":
        run(schtasks("/End", "/TN", TASK_NAME))
        r = run(schtasks("/Run", "/TN", TASK_NAME))
    elif platform.system() == "Darwin":
        r = run(["launchctl", "kickstart", "-k", "gui/%d/%s" % (os.getuid(), LABEL)])
    else:
        r = run(["systemctl", "--user", "restart", "edu4self.service"])
    print(r.stdout.strip() or "Restarted.")
    return r.returncode


def cmd_status(args):
    vault, port = resolve(args)
    h = health(port)
    print("vault:    %s" % (vault or "(none yet: ./edu4self init PATH)"))
    print("port:     %d" % port)
    print("server:   %s" % ("running, edu4self %s" % h.get("version") if h else "not answering"))
    print("service:  %s" % ("installed (starts at login)" if service_installed() else "not installed"))
    return 0 if h else 1


def cmd_open(args):
    url = "http://127.0.0.1:%d/" % resolve(args)[1]
    webbrowser.open(url)
    print(url)
    return 0


# ---------------------------------------------------------------- doctor

def lesson_skill_found():
    """True when the plugin's own write-lesson and check-inbox skills are installed for Claude Code."""
    home = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude")
    found = set()
    for root, dirs, files in os.walk(os.path.join(home, "plugins")):
        if os.path.basename(root) in ("write-lesson", "check-inbox") and "SKILL.md" in files:
            found.add(os.path.basename(root))
        if root.count(os.sep) - home.count(os.sep) > 8:
            dirs[:] = []
    return found == {"write-lesson", "check-inbox"}


def claude_line(windows=None, which=shutil.which):
    """doctor's line about Claude Code: found, or why the dashboard can't run it."""
    sys.path.insert(0, APP)
    import claude_cli
    windows = os.name == "nt" if windows is None else windows
    override = os.environ.get("EDU4SELF_CLAUDE") or ""
    cmd, why = claude_cli.find(override, which, windows)
    if cmd:
        npm = windows and "node_modules" in cmd[-1]
        return "✓", "Claude Code found" + (" (npm's: the dashboard runs %s directly, not claude.cmd)" % " ".join(cmd) if npm else "")
    if windows and (which("claude.cmd") or override.lower().endswith((".cmd", ".bat"))):
        return "✗", "npm's claude.cmd found, but the dashboard's Claude panel can't use it: %s" % why
    return "✗", "Claude Code not found: https://claude.com/claude-code (the tutor that grades your work)"


def login_line():
    """doctor's line about the Claude Code login, from the dashboard's own check (server.claude_ready), so the two
    never disagree. Asked only once Claude Code is found."""
    import server
    ok = server.claude_ready()["logged_in"]
    if ok:
        return "✓", "Claude Code is signed in"
    if ok is False:
        return "✗", "Claude Code isn't signed in, so nothing can be graded: run claude auth login"
    return "–", "Claude Code login unknown (this version has no claude auth status; updating Claude Code adds it)"


PLUGIN = "edu4self@edu4self"
PLUGIN_STEPS = (("plugin", "marketplace", "add", "chillax97/edu4self"), ("plugin", "install", PLUGIN))


def find_claude():
    """The command (a list) the dashboard itself runs Claude with, or None: setup, doctor and the page agree."""
    import server
    return server.claude_cmd()


def claude_json(claude, *a):
    """What `claude ... --json` printed, or None when it failed or printed something else."""
    try:
        r = subprocess.run(claude + list(a), stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                           encoding="utf-8", errors="replace", timeout=60)
        return json.loads(r.stdout) if r.returncode == 0 else None
    except (OSError, subprocess.SubprocessError, ValueError):
        return None


def plugin_status(claude):
    """'enabled', 'disabled' or 'missing', as `claude plugin list --json` tells it; None when claude can't say."""
    got = claude_json(claude, "plugin", "list", "--json")
    if not isinstance(got, list):
        return None
    found = [p.get("enabled") is True for p in got if isinstance(p, dict) and p.get("id") == PLUGIN]
    return "enabled" if any(found) else "disabled" if found else "missing"


def marketplace_added(claude):
    got = claude_json(claude, "plugin", "marketplace", "list", "--json")
    return isinstance(got, list) and any(isinstance(m, dict) and m.get("name") == PLUGIN.split("@")[1] for m in got)


def install_plugin(claude):
    """Add the marketplace and install the tutor plugin, skipping what's already there. True when it ends up enabled."""
    status = plugin_status(claude)
    if status == "enabled":
        say("✓", "the tutor plugin is already installed")
        return True
    if status == "disabled":
        steps = [("plugin", "enable", PLUGIN)]
    elif marketplace_added(claude):
        say("✓", "the edu4self marketplace is already added")
        steps = [PLUGIN_STEPS[1]]
    else:
        steps = list(PLUGIN_STEPS)
    for step in steps:
        print("  $ claude %s" % " ".join(step))
        try:
            r = subprocess.run(claude + list(step), stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                               encoding="utf-8", errors="replace", timeout=300)
            out, rc = r.stdout, r.returncode
        except (OSError, subprocess.SubprocessError) as exc:
            out, rc = str(exc), 1
        for line in [l for l in out.splitlines() if l.strip()][-4:]:
            print("    " + line.strip())
        if rc:
            break
    if plugin_status(claude) == "enabled":
        say("✓", "the tutor plugin is installed and enabled")
        return True
    say("✗", "the tutor plugin didn't install. Run step 1 below by hand, then ./edu4self doctor")
    return False


def print_plugin_steps():
    for step in PLUGIN_STEPS:
        print("       claude %s" % " ".join(step))


RELEASES_URL = "https://api.github.com/repos/chillax97/edu4self/releases/latest"
PLUGIN_UPDATE_STEPS = (("plugin", "marketplace", "update", "edu4self"), ("plugin", "update", PLUGIN))


def server_version():
    import server
    return server.VERSION


def version_tuple(v):
    try:
        return tuple(int(x) for x in v.strip().lstrip("v").split("."))
    except ValueError:
        return None


def latest_release(timeout=2):
    """The tag of the newest GitHub release, or None offline or on any trouble. One GET to api.github.com;
    nothing about you or your vault is sent. EDU4SELF_NO_UPDATE_CHECK=1 turns it off."""
    if os.environ.get("EDU4SELF_NO_UPDATE_CHECK"):
        return None
    try:
        req = urllib.request.Request(RELEASES_URL, headers={"User-Agent": "edu4self-doctor", "Accept": "application/vnd.github+json"})
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.load(r).get("tag_name") or None
    except Exception:
        return None


def newer_release():
    """The newest release tag when it is newer than the running version, else None."""
    tag = latest_release()
    have, got = version_tuple(server_version()), version_tuple(tag or "")
    return tag if have and got and got > have else None


def cmd_doctor(args):
    vault, port = resolve(args)
    bad = 0
    print("edu4self doctor")
    if sys.version_info >= (3, 9):
        say("✓", "Python %s" % platform.python_version())
    else:
        bad += 1
        say("✗", "Python %s is too old: install 3.9 or newer" % platform.python_version())
    if vault and os.path.isfile(os.path.join(vault, "_system", "state.json")):
        say("✓", "vault: %s" % vault)
        r1 = run([sys.executable, os.path.join(APP, "validate_state.py"), vault])
        r2 = run([sys.executable, os.path.join(APP, "check_links.py"), vault])
        if r1.returncode or r2.returncode or not check_themes(vault, quiet=True):
            bad += 1
            say("✗", "vault check failed. Ask Claude to fix it, or run ./edu4self check to see why")
        else:
            say("✓", "state.json, links and rooms are valid")
    else:
        bad += 1
        say("✗", "no vault yet: ./edu4self init ~/learn")
    h = health(port)
    if h:
        say("✓", "dashboard answering on http://127.0.0.1:%d/ (edu4self %s)" % (port, h.get("version")))
    else:
        bad += 1
        say("✗", "nothing answers on port %d: ./edu4self serve, or ./edu4self install" % port)
    newer = newer_release()
    if newer:
        say("↑", "edu4self %s is out (this is %s). To update:  cd %s && git pull && ./edu4self restart" % (newer[1:] if newer[:1] == "v" else newer, server_version(), shell_quote(ENGINE)))
        say(" ", "then update the tutor skills too, they are a separate copy:  %s" % " && ".join("claude " + " ".join(c) for c in PLUGIN_UPDATE_STEPS))
    say("✓" if service_installed() else "–", "login service %s" % ("installed" if service_installed() else "not installed (optional: ./edu4self install)"))
    mark, line = claude_line()
    if mark == "✗":
        bad += 1
    say(mark, line)
    if mark == "✓":
        mark, line = login_line()
        if mark == "✗":
            bad += 1
        say(mark, line)
    claude = find_claude()
    status = plugin_status(claude) if claude else None
    if status is None:      # no claude we can ask: look for the skills on disk instead
        status = "enabled" if lesson_skill_found() else "missing"
    if status == "enabled":
        say("✓", "tutor skills installed (edu4self plugin, enabled)")
    elif status == "disabled":
        bad += 1
        say("✗", "the edu4self plugin is installed but disabled: claude plugin enable %s" % PLUGIN)
    else:
        bad += 1
        say("✗", "tutor skills not found: ./edu4self setup installs them, or run %s" % " && ".join("claude " + " ".join(s) for s in PLUGIN_STEPS))
    print("All good." if not bad else "%d thing%s to fix." % (bad, "" if bad == 1 else "s"))
    return 1 if bad else 0


